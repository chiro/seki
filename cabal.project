packages: .
index-state: 2026-08-08T10:30:36Z

with-compiler: ghc-9.14.1
write-ghc-environment-files: never

-- Arch's ghc-libs package ships dynamic libraries; keeping development builds
-- dynamic avoids requiring the much larger ghc-static package.
shared: true
library-vanilla: false
executable-dynamic: true

package *
  shared: true
  library-vanilla: false

tests: true
benchmarks: true
