cabal-version:      3.0
name:               seki
version:            0.1.0.0
synopsis:           A tiling window manager for river
description:
  seki is a tiling window manager for river, with xmonad's semantics and
  configuration model.
homepage:            https://github.com/chiro/seki
bug-reports:         https://github.com/chiro/seki/issues
license:             MIT
license-file:        LICENSE
author:              chiro
maintainer:          chiro
category:            System
build-type:          Simple
tested-with:         GHC ==9.6.6
extra-source-files:
  cbits/seki_wayland_transport.h
  fourmolu.yaml
  protocol/SHA256SUMS
  protocol/SOURCES.md
  protocol/river/river-window-management-v1.xml
  protocol/river/river-xkb-bindings-v1.xml
  protocol/wayland/wayland.xml
extra-doc-files:
  README.md
  THIRD_PARTY_NOTICES.md
  docs/spec.md
  docs/wire-protocol.md

common warnings
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          warnings
  hs-source-dirs:  src
  exposed-modules: Seki
  build-depends:
    base >=4.18 && <4.19

library seki-wire
  import:          warnings
  visibility:      private
  hs-source-dirs:
    src
    src-generated
  include-dirs:    cbits
  includes:        seki_wayland_transport.h
  c-sources:       cbits/seki_wayland_transport.c
  cc-options:      -Wall -Wextra -Wpedantic
  exposed-modules:
    Seki.Protocol.Wayland
    Seki.Wire.Arguments
    Seki.Wire.Binding
    Seki.Wire.Codec
    Seki.Wire.Connection
    Seki.Wire.Connection.Buffer
    Seki.Wire.Connection.Event
    Seki.Wire.Connection.ObjectTable
    Seki.Wire.Connection.Request
    Seki.Wire.Transport
    Seki.Wire.Transport.Driver
    Seki.Wire.Types
  other-modules:
    Seki.Wire.Transport.Syscall
  build-depends:
    base >=4.18 && <4.19,
    binary >=0.8.9 && <0.9,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    filepath >=1.4.3 && <1.6,
    network >=3.1.4 && <3.3,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9

library scanner
  import:          warnings
  visibility:      private
  hs-source-dirs:  tools/scanner
  exposed-modules:
    Seki.Scanner.Generate
    Seki.Scanner.IR
    Seki.Scanner.Parse
  build-depends:
    base >=4.18 && <4.19,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    text >=2.0.2 && <2.2,
    xeno >=0.6 && <0.7

executable seki-scanner
  import:         warnings
  hs-source-dirs: tools/scanner/app
  main-is:        Main.hs
  build-depends:
    base >=4.18 && <4.19,
    directory >=1.3.8 && <1.4,
    filepath >=1.4.3 && <1.6,
    seki:scanner,
    text >=2.0.2 && <2.2

test-suite seki-test
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Seki.Scanner.GenerateTest
    Seki.Scanner.ParseTest
    Seki.Wire.ArgumentsTest
    Seki.Wire.CodecTest
    Seki.Wire.ConnectionTest
    Seki.Wire.Connection.BufferTest
    Seki.Wire.Connection.EventTest
    Seki.Wire.Connection.ObjectTableTest
    Seki.Wire.Connection.RequestTest
    Seki.Wire.Transport.DriverTest
    Seki.Wire.TransportTest
  build-depends:
    QuickCheck >=2.15 && <2.16,
    base >=4.18 && <4.19,
    binary >=0.8.9 && <0.9,
    bytestring >=0.11.5 && <0.12,
    network >=3.1.4 && <3.3,
    seki:scanner,
    seki:seki-wire,
    tasty >=1.5 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    temporary >=1.3 && <1.4,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9

source-repository head
  type:     git
  location: https://github.com/chiro/seki.git
