cabal-version:      3.0
name:               seki
version:            0.1.0.0
synopsis:           A tiling window manager for river
description:
  seki is a tiling window manager for river, with xmonad's semantics and
  configuration model.
homepage:            https://github.com/chiro/seki
bug-reports:         https://github.com/chiro/seki/issues
license:             MIT
license-file:        LICENSE
author:              chiro
maintainer:          chiro
category:            System
build-type:          Simple
tested-with:         GHC ==9.6.6
extra-source-files:
  tools/latency/run.py
  tools/latency/test_report.py
  cbits/seki_wayland_transport.h
  fourmolu.yaml
  protocol/SHA256SUMS
  protocol/SOURCES.md
  protocol/river/river-layer-shell-v1.xml
  protocol/river/river-window-management-v1.xml
  protocol/river/river-xkb-bindings-v1.xml
  protocol/river/upstream/wlr-layer-shell-unstable-v1.xml
  protocol/wayland-protocols/xdg-shell.xml
  protocol/wayland-protocols/ext-image-capture-source-v1.xml
  protocol/wayland-protocols/ext-image-copy-capture-v1.xml
  protocol/wayland-protocols/ext-foreign-toplevel-list-v1.xml
  protocol/wayland/wayland.xml
  protocol/wlr-protocols/wlr-virtual-pointer-unstable-v1.xml
extra-doc-files:
  README.md
  THIRD_PARTY_NOTICES.md
  docs/integration-testing.md
  docs/latency.md
  docs/latency-baseline/report.md
  docs/latency-baseline/summary.json
  docs/latency-baseline/manifest.json
  docs/latency-baseline/profile-summary.json
  docs/m1-plan.md
  docs/reconciliation.md
  docs/spec.md
  docs/wire-protocol.md

common warnings
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          warnings
  hs-source-dirs:  src-public
  exposed-modules:
    Seki
    Seki.Core.Geometry
    Seki.Core.Layout
    Seki.Core.StackSet
    Seki.Layout.Full
    Seki.Layout.Tall
  build-depends:
    base >=4.18 && <4.19,
    seki:seki-core,
    seki:seki-wire

library seki-core
  import:          warnings
  visibility:      private
  hs-source-dirs:  src-core
  exposed-modules:
    Seki.Internal.Config
    Seki.Internal.Core.Action
    Seki.Internal.Core.Event
    Seki.Internal.Core.Geometry
    Seki.Internal.Core.Layout
    Seki.Internal.Core.ManageHook
    Seki.Internal.Core.PointerOp
    Seki.Internal.Core.Restore
    Seki.Internal.Core.StackSet
    Seki.Internal.Core.State
    Seki.Internal.Core.Scene
    Seki.Internal.Layout.Full
    Seki.Internal.Layout.Tall
  build-depends:
    base >=4.18 && <4.19,
    containers >=0.6.7 && <0.8,
    text >=2.0.2 && <2.2,
    transformers >=0.6.1 && <0.7

library seki-wire
  import:          warnings
  visibility:      private
  hs-source-dirs:
    src
    src-generated
  include-dirs:    cbits
  includes:        seki_wayland_transport.h
  c-sources:       cbits/seki_wayland_transport.c
  cc-options:      -Wall -Wextra -Wpedantic
  exposed-modules:
    Seki.Protocol.RiverLayerShellV1
    Seki.Protocol.RiverWindowManagementV1
    Seki.Protocol.RiverXkbBindingsV1
    Seki.Protocol.Wayland
    Seki.Run.Inventory
    Seki.Run.LayerShell
    Seki.Run.Latency
    Seki.Run.Config
    Seki.Run.Phase
    Seki.Run.Pointer
    Seki.Run.Policy
    Seki.Run.Reconcile
    Seki.Run.River
    Seki.Run.Runtime
    Seki.Run.Sequence
    Seki.Run.Startup
    Seki.Run.Xkb
    Seki.Wire.Arguments
    Seki.Wire.Binding
    Seki.Wire.Codec
    Seki.Wire.Connection
    Seki.Wire.Connection.Buffer
    Seki.Wire.Connection.Event
    Seki.Wire.Connection.ObjectTable
    Seki.Wire.Connection.Request
    Seki.Wire.Connection.Registry
    Seki.Wire.Transport
    Seki.Wire.Transport.Driver
    Seki.Wire.Types
  other-modules:
    Seki.Wire.Transport.Syscall
  build-depends:
    base >=4.18 && <4.19,
    binary >=0.8.9 && <0.9,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    filepath >=1.4.3 && <1.6,
    network >=3.1.4 && <3.3,
    process >=1.6.18 && <1.7,
    seki:seki-core,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9

library scanner
  import:          warnings
  visibility:      private
  hs-source-dirs:  tools/scanner
  exposed-modules:
    Seki.Scanner.Generate
    Seki.Scanner.IR
    Seki.Scanner.Parse
  build-depends:
    base >=4.18 && <4.19,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    text >=2.0.2 && <2.2,
    xeno >=0.6 && <0.7

library layer-surface-fixture
  import:          warnings
  visibility:      private
  hs-source-dirs:
    tools/layer-surface-fixture/src
    tools-generated/layer-surface-fixture
  exposed-modules:
    Seki.Fixture.LayerSurface
    Seki.Fixture.Probe
    Seki.Fixture.Protocol.XdgShell
    Seki.Fixture.Protocol.ExtImageCaptureSourceV1
    Seki.Fixture.Protocol.ExtImageCopyCaptureV1
    Seki.Fixture.Protocol.WlrLayerShellUnstableV1
    Seki.Fixture.Protocol.WlrVirtualPointerUnstableV1
  build-depends:
    containers >=0.6.7 && <0.8,
    base >=4.18 && <4.19,
    bytestring >=0.11.5 && <0.12,
    seki:seki-wire,
    text >=2.0.2 && <2.2,
    transformers >=0.6.1 && <0.7,
    unix >=2.8.4 && <2.9

executable seki-scanner
  import:         warnings
  hs-source-dirs: tools/scanner/app
  main-is:        Main.hs
  build-depends:
    base >=4.18 && <4.19,
    directory >=1.3.8 && <1.4,
    filepath >=1.4.3 && <1.6,
    seki:scanner,
    text >=2.0.2 && <2.2

executable seki-registry-smoke
  import:         warnings
  hs-source-dirs: tools/registry-smoke/app
  main-is:        Main.hs
  build-depends:
    base >=4.18 && <4.19,
    seki:seki-wire,
    text >=2.0.2 && <2.2

executable seki-layer-surface-fixture
  import:         warnings
  hs-source-dirs: tools/layer-surface-fixture/app
  main-is:        Main.hs
  build-depends:
    base >=4.18 && <4.19,
    seki:layer-surface-fixture,
    seki:seki-wire,
    unix >=2.8.4 && <2.9

executable seki
  import:         warnings
  hs-source-dirs: tools/seki/app
  main-is:        Main.hs
  build-depends:
    base >=4.18 && <4.19,
    seki

test-suite seki-test
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test tools/latency
  main-is:        Main.hs
  other-modules:
    Seki.Fixture.LayerSurfaceTest
    Seki.Internal.Core.ActionTest
    Seki.Internal.Core.EventTest
    Seki.Internal.Core.GeometryGen
    Seki.Internal.Core.GeometryTest
    Seki.Internal.Core.LayoutTest
    Seki.Internal.Core.ManageHookTest
    Seki.Internal.Core.PointerOpTest
    Seki.Internal.Core.RestoreTest
    Seki.Internal.Core.StackSetGen
    Seki.Internal.Core.StackSetTest
    Seki.Internal.Core.StateTest
    Seki.Internal.Core.SceneTest
    Seki.Internal.Layout.FullTest
    Seki.Internal.Layout.TallTest
    Seki.Scanner.GenerateTest
    Seki.Scanner.ParseTest
    Seki.Run.InventoryTest
    Seki.Run.LatencyTest
    Seki.Run.LatencyPureTest
    Seki.Latency.Pure
    Seki.Run.MockRiver
    Seki.Run.ConfigTest
    Seki.Run.PhaseTest
    Seki.Run.PolicyTest
    Seki.Run.ReconcileTest
    Seki.Run.ReconcileTraceTest
    Seki.Run.RiverTest
    Seki.Run.RuntimeTest
    Seki.Run.SequenceTest
    Seki.Run.StartupTest
    Seki.Wire.ArgumentsTest
    Seki.Wire.CodecTest
    Seki.Wire.ConnectionTest
    Seki.Wire.Connection.BufferTest
    Seki.Wire.Connection.DispatchTest
    Seki.Wire.Connection.EventTest
    Seki.Wire.Connection.ObjectTableTest
    Seki.Wire.Connection.RequestTest
    Seki.Wire.Connection.RegistryTest
    Seki.Wire.Transport.DriverTest
    Seki.Wire.TransportTest
  build-depends:
    aeson >=2.1 && <2.3,
    QuickCheck >=2.14.3 && <2.16,
    base >=4.18 && <4.19,
    binary >=0.8.9 && <0.9,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    network >=3.1.4 && <3.3,
    process >=1.6.18 && <1.7,
    seki:layer-surface-fixture,
    seki:scanner,
    seki:seki-core,
    seki:seki-wire,
    tasty >=1.4.3 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.10 && <0.12,
    temporary >=1.3 && <1.4,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9

test-suite seki-public
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test-public
  main-is:        Main.hs
  other-modules:  ConfigMain
  build-depends:
    base >=4.18 && <4.19,
    seki

test-suite seki-integration
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: integration
  main-is:        Main.hs
  other-modules:
    Seki.Integration.Fixture
    Seki.Integration.Harness
    Seki.Integration.M1
    Seki.Integration.M2
  build-depends:
    containers >=0.6.7 && <0.8,
    seki:layer-surface-fixture,
    aeson >=2.1 && <2.3,
    base >=4.18 && <4.19,
    bytestring >=0.11.5 && <0.12,
    directory >=1.3.8 && <1.4,
    filepath >=1.4.3 && <1.6,
    network >=3.1.4 && <3.3,
    process >=1.6.18 && <1.7,
    seki:seki-wire,
    seki:seki-core,
    temporary >=1.3 && <1.4,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9

executable seki-latency
  import: warnings
  hs-source-dirs: tools/latency integration
  main-is: Main.hs
  ghc-options: -O2 -threaded -rtsopts
  other-modules:
    Seki.Latency.Pure
    Seki.Latency.Live
    Seki.Integration.Harness
  build-depends:
    base >=4.18 && <4.19,
    aeson >=2.1 && <2.3,
    bytestring >=0.11.5 && <0.12,
    containers >=0.6.7 && <0.8,
    directory >=1.3.8 && <1.4,
    filepath >=1.4.3 && <1.6,
    network >=3.1.4 && <3.3,
    process >=1.6.18 && <1.7,
    temporary >=1.3 && <1.4,
    text >=2.0.2 && <2.2,
    unix >=2.8.4 && <2.9,
    seki:seki-core,
    seki:seki-wire,
    seki:layer-surface-fixture

source-repository head
  type:     git
  location: https://github.com/chiro/seki.git
